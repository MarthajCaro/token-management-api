# Copia este archivo como .env y completa los valores.
# El archivo .env esta en .gitignore y nunca debe subirse al repositorio.

# --- Base de datos (PostgreSQL) ---
DB_NAME=token_management
DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# --- Credenciales del cliente (grant client_credentials) ---
# Solo se usan en POST /api/auth/token. No se envian nunca al navegador.
CLIENT_ID=client_01
CLIENT_SECRET=

# --- Firma de los JWT ---
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- CORS ---
# Orígenes permitidos, separados por coma. Usa * para permitir cualquiera.
# En producción pon aquí el dominio del frontend, por ejemplo:
# CORS_ORIGIN=https://marthajcaro.github.io
CORS_ORIGIN=http://localhost:4200

# Render asigna este valor automaticamente. No lo cambies en produccion.
PORT=3000